# Copy to backend/.env (the backend reads .env from its working directory). NEVER commit real values.

# ---- core ----
APPLYPILOT_ENV=development                      # development | production
APPLYPILOT_DATABASE_URL=sqlite:///./applypilot.db
# Production: postgresql+psycopg://user:password@host:5432/applypilot
# REQUIRED in production (>=32 random chars):  python -c "import secrets; print(secrets.token_urlsafe(48))"
APPLYPILOT_SECRET_KEY=dev-insecure-key-change-me-dev-insecure-key
APPLYPILOT_ACCESS_TOKEN_MINUTES=60

# ---- CORS (JSON list). In production pin your real extension origin(s) ----
APPLYPILOT_CORS_ORIGINS=["http://localhost:5173"]
# Dev default allows any chrome-extension://<32 a-p chars>. Production example (pin YOUR extension ID):
# APPLYPILOT_CORS_ORIGIN_REGEX=^chrome-extension://abcdefghijklmnopabcdefghijklmnop$

# ---- uploads ----
APPLYPILOT_UPLOAD_DIR=./storage/resumes
APPLYPILOT_MAX_UPLOAD_BYTES=5242880

# ---- AI provider (optional; the app works without one, only AI explanations need it) ----
# none | openai_compatible | anthropic
APPLYPILOT_AI_PROVIDER=none
# openai_compatible examples:
#   OpenAI:  BASE_URL=https://api.openai.com/v1  MODEL=<a chat model you have access to>  API_KEY=sk-...
#   Ollama:  BASE_URL=http://localhost:11434/v1  MODEL=llama3.1                           (no API key needed)
# anthropic: MODEL=<a Claude model id>  API_KEY=sk-ant-...
APPLYPILOT_AI_BASE_URL=
APPLYPILOT_AI_MODEL=
APPLYPILOT_AI_API_KEY=

# ---- scoring (optional overrides; these are starting assumptions, not validated constants) ----
# APPLYPILOT_SCORE_WEIGHTS={"required_skills":0.35,"preferred_skills":0.20,"semantic":0.20,"experience":0.15,"education":0.10}
APPLYPILOT_SEMANTIC_BACKEND=lexical             # lexical | sentence-transformers (needs: pip install sentence-transformers)
